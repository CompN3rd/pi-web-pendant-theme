{
  "name": "@compn3rd/pi-web-pendant-theme",
  "version": "0.6.1",
  "description": "Pendant-inspired theme for PI WEB: Source Sans 3 body font, Press Start 2P pixel accents, sharp corners, flat surfaces, subtle pixel grid. Includes 6 dark variants (Amber CRT, Green Phosphor, Cyan/Teal, Nearly Monochrome, Muted Everything, plus the original) and a light variant.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node test-parse-command.js && node test-command-logo-layout.js && node test-plugin-contract.js && node test-theme-appearance.js && node --test test-visual-review.mjs",
    "test:visual": "node scripts/visual-review.mjs",
    "review:render": "node scripts/render-comparisons.mjs",
    "verify:parser": "node scripts/verify-parser-sync.mjs",
    "prepublishOnly": "npm test && npm run verify:parser"
  },
  "files": [
    "CHANGELOG.md",
    "pi-web-plugin.js",
    "lib",
    "scripts/verify-parser-sync.mjs",
    "styles",
    "fonts",
    "logos"
  ],
  "keywords": [
    "pi-package",
    "pi-web",
    "pi-web-plugin",
    "theme",
    "pendant",
    "8-bit",
    "retro",
    "command-logos",
    "pi-web.dev-plugin"
  ],
  "pi": {
    "extensions": []
  },
  "piWeb": {
    "plugins": [
      {
        "id": "pendant",
        "browserRoot": ".",
        "module": "pi-web-plugin.js",
        "themes": [
          { "id": "dark", "name": "Pendant Dark", "description": "8-bit Pendant look: pixel fonts, sharp boxes, flat dark surfaces.", "order": 40, "colorScheme": "dark", "loadingScreen": { "background": "#111111", "foreground": "#f5f5f5", "logo": "#4f8cff" }, "stylesheets": [{ "id": "palette", "path": "styles/dark.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] },
          { "id": "amber", "name": "Amber CRT", "description": "Pitch black bg, warm amber glow — like an old monochrome terminal.", "order": 44, "colorScheme": "dark", "loadingScreen": { "background": "#050505", "foreground": "#ffb000", "logo": "#ffb000" }, "stylesheets": [{ "id": "palette", "path": "styles/amber.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] },
          { "id": "green", "name": "Green Phosphor", "description": "Deep black bg, classic matrix green — retro green-screen.", "order": 45, "colorScheme": "dark", "loadingScreen": { "background": "#050505", "foreground": "#00ff41", "logo": "#00ff41" }, "stylesheets": [{ "id": "palette", "path": "styles/green.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] },
          { "id": "cyan", "name": "Cyan/Teal", "description": "Near-black bg, cool cyan accents — modern-retro hybrid.", "order": 46, "colorScheme": "dark", "loadingScreen": { "background": "#080b0d", "foreground": "#c8e6f0", "logo": "#00d4ff" }, "stylesheets": [{ "id": "palette", "path": "styles/cyan.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] },
          { "id": "mono", "name": "Nearly Monochrome", "description": "Pure grayscale — every accent is just a different shade of gray.", "order": 47, "colorScheme": "dark", "loadingScreen": { "background": "#080808", "foreground": "#e0e0e0", "logo": "#cccccc" }, "stylesheets": [{ "id": "palette", "path": "styles/mono.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] },
          { "id": "muted", "name": "Muted Everything", "description": "Desaturated hints, barely-there color — 5–10% saturation.", "order": 48, "colorScheme": "dark", "loadingScreen": { "background": "#0a0a0a", "foreground": "#dfdfdf", "logo": "#8899aa" }, "stylesheets": [{ "id": "palette", "path": "styles/muted.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] },
          { "id": "light", "name": "Pendant Light", "description": "8-bit Pendant look: pixel fonts, sharp boxes, flat light surfaces.", "order": 50, "colorScheme": "light", "loadingScreen": { "background": "#fafafa", "foreground": "#161616", "logo": "#145fd7" }, "stylesheets": [{ "id": "palette", "path": "styles/light.css", "order": 1000 }, { "id": "structure", "path": "styles/pendant.css", "order": 1010 }] }
        ],
        "themePairs": [{ "id": "auto", "name": "Pendant", "description": "Follow the system light/dark preference with Pendant themes.", "order": 20, "light": "light", "dark": "dark" }]
      }
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompN3rd/pi-web-pendant-theme.git"
  },
  "bugs": {
    "url": "https://github.com/CompN3rd/pi-web-pendant-theme/issues"
  },
  "homepage": "https://github.com/CompN3rd/pi-web-pendant-theme#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
